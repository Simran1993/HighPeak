# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=highpeak
DB_USER=highpeak
DB_PASS=change-me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 64 characters. Generate with: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64-minimum-64-chars!!

# ── Mail (use a real SMTP provider in production, e.g. SendGrid, Resend) ──────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=change-me

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Google OAuth2 (optional — leave empty to disable) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
