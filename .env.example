# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=highpeak
DB_USER=highpeak
DB_PASS=change-me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 64 characters. Generate with: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64-minimum-64-chars!!

# ── Mail (use a real SMTP provider in production, e.g. SendGrid, Resend) ──────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=change-me

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Google OAuth2 (optional — leave empty to disable) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI itinerary generation (Groq — free tier, get a key at console.groq.com) ─
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Lower this if your model/tier's free tokens-per-minute limit is below ~8000
# (some models, e.g. openai/gpt-oss-120b, cap as low as 8000 TPM total).
# GROQ_MAX_COMPLETION_TOKENS=4000
